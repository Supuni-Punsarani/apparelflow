generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  passwordHash     String
  role             String
  fullName         String
  createdAt        DateTime          @default(now())
  orders           CuttingOrder[]
  verificationLogs VerificationLog[]
}

model Recipe {
  id             String            @id @default(cuid())
  recipeCode     String            @unique
  name           String
  category       String
  stdFabricYards Float
  wastageCap     Float
  components     RecipeComponent[]
  orders         CuttingOrder[]
}

model RecipeComponent {
  id                String             @id @default(cuid())
  recipeId          String
  recipe            Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  componentName     String
  piecesPerGarment  Int
  imageUrl          String?
  verificationItems VerificationItem[]
}

model CuttingOrder {
  id                String             @id @default(cuid())
  orderNo           String             @unique
  recipeId          String
  recipe            Recipe             @relation(fields: [recipeId], references: [id])
  targetQty         Int
  fabricRollId      String
  actualFabricYds   Float
  status            String             @default("CUTTING_IN_PROGRESS")
  createdBy         String
  creator           User               @relation(fields: [createdBy], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  verificationItems VerificationItem[]
  verificationLogs  VerificationLog[]
}

model VerificationItem {
  id          String          @id @default(cuid())
  orderId     String
  order       CuttingOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  componentId String
  component   RecipeComponent @relation(fields: [componentId], references: [id])
  expectedQty Int
  actualQty   Int?
  status      String?

  @@unique([orderId, componentId])
}

model VerificationLog {
  id            String       @id @default(cuid())
  orderId       String
  order         CuttingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifierId    String
  verifier      User         @relation(fields: [verifierId], references: [id])
  decision      String
  rejectionNote String?
  wastagePct    Float?
  timestamp     DateTime     @default(now())
}
